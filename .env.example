# DuMeGud environment. Copy to .env.local and fill in.
# Validated in server/env.ts. Variables marked (Phase N) are added to the schema when that phase lands.

# ── App (Phase 0) ─────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000          # canonical host; used for Monime redirect URLs and emails
LOG_LEVEL=info                              # debug | info | warn | error

# ── Database: Neon (Phase 0) ──────────────────────────────────────────────────
# App role (DML only) — use the *pooled* connection string.
DATABASE_URL=postgres://app_rw:password@ep-xxx-pooler.region.aws.neon.tech/dumegud?sslmode=require
# Migration role (DDL) — used only by drizzle-kit / CI. Falls back to DATABASE_URL if unset.
DATABASE_URL_MIGRATOR=

# ── Security (Phase 0) ────────────────────────────────────────────────────────
HASH_PEPPER=                                # openssl rand -base64 48
# Rate limiting (Upstash via Vercel Marketplace). Optional in dev (in-memory fallback), required in prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# CI/E2E only: lets a production build (`next start`) run without Upstash. Refused on Vercel production.
ALLOW_MEMORY_RATE_LIMIT=false

# ── Auth: Auth.js v5 (Phase 1) ────────────────────────────────────────────────
AUTH_SECRET=                                # openssl rand -base64 32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (Phase 1) ───────────────────────────────────────────────────────────
EMAIL_ENABLED=false                         # false → emails are logged to the console instead of sent
EMAIL_PROVIDER=console                      # cloudflare | console
EMAIL_FROM="DuMeGud <no-reply@dumegud.com>"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# ── Monime (Phase 2–4) ────────────────────────────────────────────────────────
MONIME_ENVIRONMENT=fake                     # fake (in-memory, dev/tests; refused on Vercel prod) | test | live
MONIME_BASE_URL=https://api.monime.io/v1
MONIME_VERSION=caph.2025-08-23              # required header
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=                      # required unless fake (the fake uses a built-in dev secret)
MONIME_PLATFORM_ACCOUNT_ID=                 # fac-… created manually in the Monime dashboard

# ── Cloudflare R2 (Phase 2/5/6) ───────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket for raw browser uploads (needs a CORS rule allowing PUT from APP_BASE_URL and
# a lifecycle rule deleting staging/ after 1 day).
R2_UPLOADS_BUCKET=dumegud-uploads
R2_PRODUCTS_BUCKET=dumegud-products
R2_KYC_BUCKET=dumegud-kyc
R2_PUBLIC_BUCKET=dumegud-public
R2_PUBLIC_BASE_URL=                         # e.g. https://cdn.dumegud.com (custom domain on the public bucket); added to the CSP at build time

# ── Field encryption & signing (Phase 5/6) ────────────────────────────────────
FIELD_ENCRYPTION_KEY=                       # base64, 32 bytes
DOWNLOAD_SIGNING_SECRET=

# ── Jobs (Phase 9) ────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Observability (Phase 10) ──────────────────────────────────────────────────
SENTRY_DSN=
